<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.tallerbicicletas.controlador.BicicletasController">
    <children>
        <Label layoutX="350.0" layoutY="14.0" text="Taller de Bicicletas" textFill="#5b5b5b">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="25.0" layoutY="44.0" text="Registro de bicicletas">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="25.0" layoutY="85.0" text="Tipo:" />
        <ComboBox fx:id="cmbTipo" layoutX="140.0" layoutY="81.0" prefWidth="150.0" promptText="Seleccione..." />

        <Label layoutX="25.0" layoutY="120.0" text="Código:" />
        <TextField fx:id="txtCodigo" layoutX="140.0" layoutY="116.0" prefWidth="150.0" />

        <Label layoutX="25.0" layoutY="155.0" text="Año de fabricación:" />
        <TextField fx:id="txtAnyo" layoutX="140.0" layoutY="151.0" prefWidth="70.0" />

        <Label layoutX="25.0" layoutY="190.0" text="Peso (kg):" />
        <TextField fx:id="txtPeso" layoutX="140.0" layoutY="186.0" prefWidth="70.0" />

        <TitledPane fx:id="paneElectrica" collapsible="false" layoutX="25.0" layoutY="225.0" prefHeight="115.0" prefWidth="265.0" text="Datos de la bicicleta eléctrica">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                    <children>
                        <Label layoutX="14.0" layoutY="14.0" text="Autonomía (km):" />
                        <TextField fx:id="txtAutonomia" layoutX="114.0" layoutY="10.0" prefWidth="130.0" />
                        <CheckBox fx:id="chkBateria" layoutX="114.0" layoutY="40.0" mnemonicParsing="false" text="Batería certificada" />
                        <CheckBox fx:id="chkGarantia" layoutX="114.0" layoutY="65.0" mnemonicParsing="false" text="Garantía extendida" />
                    </children>
                </AnchorPane>
            </content>
        </TitledPane>

        <TitledPane fx:id="paneMontanya" collapsible="false" layoutX="25.0" layoutY="350.0" prefHeight="70.0" prefWidth="265.0" text="Datos de la bicicleta de montaña">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                    <children>
                        <Label layoutX="14.0" layoutY="14.0" text="Suspensiones:" />
                        <TextField fx:id="txtSuspensiones" layoutX="114.0" layoutY="10.0" prefWidth="130.0" />
                    </children>
                </AnchorPane>
            </content>
        </TitledPane>

        <Button layoutX="220.0" layoutY="430.0" mnemonicParsing="false" onAction="#registrarBicicleta" text="Registrar" />
        <Label fx:id="lblMensaje" layoutX="25.0" layoutY="465.0" textFill="#007c0a">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <TableView fx:id="tblBicicletas" layoutX="320.0" layoutY="81.0" prefHeight="339.0" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="colTipo" prefWidth="130.0" text="Tipo" />
                <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                <TableColumn fx:id="colAnyo" prefWidth="70.0" text="Año" />
                <TableColumn fx:id="colPeso" prefWidth="80.0" text="Peso (kg)" />
                <TableColumn fx:id="colCosto" prefWidth="120.0" text="Costo mantención" />
            </columns>
        </TableView>
        <Button layoutX="320.0" layoutY="430.0" mnemonicParsing="false" onAction="#eliminarBicicleta" text="Eliminar" />
    </children>
</AnchorPane>