<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox spacing="20" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.autofix.controlador.VehiculosController" style="-fx-padding: 20;">
    <VBox spacing="10" prefWidth="320">
        <Label text="Registro de vehículos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="10">
            <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbTipo" promptText="Seleccione..." GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="180"/>

            <Label text="Marca:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtMarca" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Año de fabricación:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtAnyo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Kilometraje:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtKilometraje" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        </GridPane>

        <TitledPane fx:id="paneAuto" text="Datos del auto" collapsible="false" disable="true">
            <VBox spacing="10">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Modelo: " prefWidth="100"/>
                    <TextField fx:id="txtModelo" HBox.hgrow="ALWAYS"/>
                </HBox>
                <CheckBox fx:id="chkGarantiaVigente" text="Garantía de fábrica vigente"/>
                <CheckBox fx:id="chkGarantiaActiva" text="Garantía activa"/>
            </VBox>
        </TitledPane>

        <TitledPane fx:id="paneFurgon" text="Datos del furgón" collapsible="false" disable="true">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Capacidad (ton): " prefWidth="100"/>
                <TextField fx:id="txtCapacidad" HBox.hgrow="ALWAYS"/>
            </HBox>
        </TitledPane>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Registrar" onAction="#registrarVehiculo" prefWidth="90"/>
        </HBox>

        <Label fx:id="lblMensaje" wrapText="true" style="-fx-font-weight: bold;"/>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <TableView fx:id="tblVehiculos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                <TableColumn fx:id="colMarca" text="Marca" prefWidth="120"/>
                <TableColumn fx:id="colAnyo" text="Año" prefWidth="80"/>
                <TableColumn fx:id="colKilometraje" text="Kilometraje" prefWidth="100"/>
                <TableColumn fx:id="colCosto" text="Costo servicio" prefWidth="120"/>
            </columns>
        </TableView>
        <Button text="Eliminar" onAction="#eliminarVehiculo" prefWidth="90"/>
    </VBox>
</HBox>