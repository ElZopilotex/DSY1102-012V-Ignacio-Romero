<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.dsy1102.timecapsule.HelloController"
      spacing="14"
      style="-fx-padding: 20;">

    <Label text="Cápsula del Tiempo" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
    <Label text="Mensajes para nuestro yo del futuro" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="campoAutor" promptText="Tu nombre"/>
        <TextField fx:id="campoTexto" promptText="Mensaje para el futuro"/>
        <ComboBox fx:id="campoPlazo"/>
        <Button text="Guardar mensaje"
                onAction="#agregarMensaje"/>
    </HBox>
    <Label fx:id="estadoRegistro" text=""/>

    <TableView fx:id="tablaMensajes" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colAutor" text="Autor" prefWidth="120" />
            <TableColumn fx:id="colTexto" text="Mensaje" prefWidth="250" />
            <TableColumn fx:id="colPlazo" text="Leer dentro de" prefWidth="120" />
        </columns>
    </TableView>

</VBox>