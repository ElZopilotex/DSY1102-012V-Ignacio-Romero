<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.viviendas.controller.MainController">
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="10" prefWidth="340">
            <Label text="Registro de viviendas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="115"/>
                    <ColumnConstraints prefWidth="215"/>
                </columnConstraints>

                <Label text="Tipo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbTipo" promptText="Seleccione..." prefWidth="215" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Código:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCodigo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Superficie (m²):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtSuperficie" maxWidth="100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Habitaciones:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtHabitaciones" maxWidth="100" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <TitledPane fx:id="paneDepto" text="Datos del departamento" collapsible="false" disable="true">
                <VBox spacing="8">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Piso:" prefWidth="65"/>
                        <TextField fx:id="txtPiso" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <VBox spacing="6" style="-fx-padding: 0 0 0 75;">
                        <CheckBox fx:id="chkGastoComun" text="Gasto común al día"/>
                        <CheckBox fx:id="chkEstacionamiento" text="Estacionamiento asignado"/>
                    </VBox>
                </VBox>
            </TitledPane>

            <TitledPane fx:id="paneCasa" text="Datos de la casa" collapsible="false" disable="true">
                <VBox style="-fx-padding: 0 0 0 75;">
                    <CheckBox fx:id="chkPatio" text="Cuenta con patio"/>
                </VBox>
            </TitledPane>

            <HBox alignment="CENTER_RIGHT">
                <Button text="Registrar" onAction="#guardarVivienda" prefWidth="90"/>
            </HBox>
        </VBox>

        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="tablaViviendas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                    <TableColumn fx:id="colSuperficie" text="Superficie (m²)" prefWidth="110"/>
                    <TableColumn fx:id="colHabitaciones" text="Habitaciones" prefWidth="95"/>
                    <TableColumn fx:id="colCosto" text="Costo arriendo" prefWidth="110"/>
                </columns>
            </TableView>
            <Button text="Eliminar" onAction="#eliminarVivienda" prefWidth="80"/>
        </VBox>
    </HBox>

    <Label fx:id="lblMensaje" style="-fx-font-weight: bold;"/>
</VBox>