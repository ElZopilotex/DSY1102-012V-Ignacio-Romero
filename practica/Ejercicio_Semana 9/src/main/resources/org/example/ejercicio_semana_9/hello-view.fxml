<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.ejercicio_semana_9.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Registro de Mascota" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="5.0">
        <Label text="Nombre de la Mascota:"/>
        <TextField fx:id="txtNombre" promptText="Ej: Perro, Gato, etc."/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Edad de la Mascota:"/>
        <TextField fx:id="txtEdad" promptText="Ingresa un entero positivo"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Categoría:"/>
        <ComboBox fx:id="cmbCategoria" promptText="Selecciona categoría" maxWidth="Infinity"/>
    </VBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Guardar" onAction="#onGuardarButtonClick"/>
        <Button text="Limpiar" onAction="#onLimpiarButtonClick"/>
    </HBox>

    <Label fx:id="lblFeedback" wrapText="true" style="-fx-text-fill: blue;"/>
</VBox>